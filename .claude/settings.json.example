{
  "_comment": "hc-gzj: enable the live agent bridge for hcolumns ITSELF. Copy to .claude/settings.json to opt in, then run `hcol serve .` and watch this session grow as you work. Note the dogfood wiring: HCOL_BIN is the working tree (exe/hcol), and the hook is the shipped TEMPLATE run in place (lib/hcolumns/templates/) so fixes made here are what other repos get. OTHER repos should not copy this file — run `hcol init` there instead. Override the log path with HCOL_BRIDGE_LOG.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HCOL_BIN=\"$CLAUDE_PROJECT_DIR/exe/hcol\" ruby \"$CLAUDE_PROJECT_DIR/lib/hcolumns/templates/agent_bridge_hook.rb\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HCOL_BIN=\"$CLAUDE_PROJECT_DIR/exe/hcol\" ruby \"$CLAUDE_PROJECT_DIR/lib/hcolumns/templates/agent_bridge_hook.rb\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HCOL_BIN=\"$CLAUDE_PROJECT_DIR/exe/hcol\" ruby \"$CLAUDE_PROJECT_DIR/lib/hcolumns/templates/agent_bridge_hook.rb\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HCOL_BIN=\"$CLAUDE_PROJECT_DIR/exe/hcol\" ruby \"$CLAUDE_PROJECT_DIR/lib/hcolumns/templates/agent_bridge_hook.rb\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HCOL_BIN=\"$CLAUDE_PROJECT_DIR/exe/hcol\" ruby \"$CLAUDE_PROJECT_DIR/lib/hcolumns/templates/agent_bridge_hook.rb\""
          }
        ]
      }
    ]
  }
}
