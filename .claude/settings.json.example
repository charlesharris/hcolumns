{
  "_comment": "hc-gzj: enable the live agent bridge. Copy to .claude/settings.json to opt in. Then, in the repo, run `hcol serve .hcolumns/live.jsonl --live` (or `walk`) and watch this session grow as you work. Override the log path with HCOL_BRIDGE_LOG.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "ruby \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_bridge_hook.rb\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "ruby \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_bridge_hook.rb\"" }
        ]
      }
    ]
  }
}
